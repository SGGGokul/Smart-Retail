# RetailIQ Monorepo Environment Variables

# --- Backend Configuration ---
PROJECT_NAME="RetailIQ Backend"
VERSION="1.0.0"
DEBUG=false

# Server Binding
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# YOLO Weights Path
MODEL_PATH="yolo11n.pt"

# PostgreSQL Configuration (Docker default: pgvector/pg17)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=retailiq
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/retailiq"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Configuration (Docker default: redis:7-alpine)
RATE_LIMIT_REDIS_URL="redis://localhost:6379/1"
RATE_LIMIT_ENABLED=true

# Groq LLM API Key (Optional: for Copilot assistant)
GROQ_API_KEY=""

# --- Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
