# RetailIQ Backend Environment Variables
PROJECT_NAME="RetailIQ Backend"
VERSION="1.0.0"
DEBUG=false

# Server Binding
HOST="127.0.0.1"
PORT=8000

# API Configuration
API_V1_PREFIX="/api/v1"

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Path to YOLO11n weights file
MODEL_PATH="yolo11n.pt"

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/retailiq"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
